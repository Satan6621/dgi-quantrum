# ===== DGI Quantrum — API =====
# Copia este archivo a `.env` y completa los valores.

# --- Servidor ---
PORT=4000
NODE_ENV=development            # production exige JWT_SECRET propio y CORS_ORIGIN real
APP_URL=http://localhost:5173   # URL pública del frontend (enlaces de emails y Stripe)
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"    # SQLite; migrable a PostgreSQL

# --- Seguridad ---
# OBLIGATORIO en producción (el arranque falla si se deja el valor por defecto)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Rate limiting ---
RATE_LIMIT_PER_IP=600
LOGIN_RATE_LIMIT=10

# --- Motor de IA (opcional: si OPENAI_API_KEY está vacío se usa el motor de reglas) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Stripe (opcional: sin clave el checkout es simulado) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Twilio / WhatsApp (opcional: sin credenciales el envío es simulado) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155238886

# --- Email SMTP (opcional: sin SMTP_HOST los emails se registran en el log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dgi-quantrum.local