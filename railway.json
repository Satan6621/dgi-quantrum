{
  "$schema": "https://railway.app/railway.schema.json",
  "projects": [
    {
      "name": "dgi-quantrum-api",
      "source": {
        "root": "apps/api"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "../../Dockerfile.api"
      },
      "deploy": {
        "startCommand": "sh -c \"npx prisma db push --skip-generate && node dist/index.js\"",
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    },
    {
      "name": "dgi-quantrum-web",
      "source": {
        "root": "apps/web"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "../../Dockerfile.web"
      },
      "deploy": {
        "startCommand": "nginx -g 'daemon off;'",
        "healthcheckPath": "/"
      }
    }
  ]
}
